///|
extern "js" fn element_value(id : String) -> String =
  #| (id) => document.getElementById(id)?.value ?? ""

///|
extern "js" fn set_text(id : String, value : String) -> Unit =
  #| (id, value) => { document.getElementById(id).textContent = value }

///|
extern "js" fn set_status(kind : String, value : String) -> Unit =
  #| (kind, value) => {
  #|   const node = document.getElementById("status")
  #|   node.dataset.kind = kind
  #|   node.textContent = value
  #| }

///|
extern "js" fn bind_click(id : String, callback : () -> Unit) -> Unit =
  #| (id, callback) => document.getElementById(id)?.addEventListener("click", callback)

///|
extern "js" fn copy_output() -> Unit =
  #| () => {
  #|   const value = document.getElementById("output")?.textContent ?? ""
  #|   if (value && value !== "Ready") navigator.clipboard?.writeText(value)
  #| }

///|
fn secure_random_u32() -> UInt {
  let bytes = match @env.rand(4) {
    Some(bytes) => bytes
    None => abort("browser crypto.getRandomValues is unavailable")
  }
  bytes[0].to_uint() |
  (bytes[1].to_uint() << 8) |
  (bytes[2].to_uint() << 16) |
  (bytes[3].to_uint() << 24)
}

///|
fn parse_positive_int(text : String) -> Int? {
  if text.length() == 0 {
    return None
  }
  let mut value = 0
  for character in text {
    let code = character.to_int()
    if code < 48 || code > 57 || value > 100000 {
      return None
    }
    value = value * 10 + code - 48
  }
  if value > 0 {
    Some(value)
  } else {
    None
  }
}

///|
fn password_policy(profile : String, length : Int) -> @lib.PasswordPolicy {
  let policy = if profile == "compatible" {
    @lib.PasswordPolicy::compatible()
  } else if profile == "strict" {
    @lib.PasswordPolicy::strict()
  } else {
    @lib.PasswordPolicy::standard()
  }
  policy.with_length(length)
}

///|
fn strength_label(entropy_x10 : Int) -> String {
  if entropy_x10 < 300 {
    "Weak"
  } else if entropy_x10 < 500 {
    "Fair"
  } else if entropy_x10 < 800 {
    "Strong"
  } else {
    "Very strong"
  }
}

///|
fn entropy_label(entropy_x10 : Int) -> String {
  let whole = entropy_x10 / 10
  let fraction = entropy_x10 % 10
  "Estimated entropy: \{whole}.\{fraction} bits · \{strength_label(entropy_x10)}"
}

///|
fn generate_password() -> Unit {
  let length = match parse_positive_int(element_value("password-length")) {
    Some(value) => value
    None => {
      set_status("error", "Length must be a positive integer.")
      return
    }
  }
  let policy = password_policy(element_value("profile"), length)
  if !policy.is_valid() {
    set_status("error", "Password length must be between 4 and 128.")
    return
  }
  match @lib.generate_password(policy, secure_random_u32) {
    Ok(value) => {
      set_text("output", value)
      set_text("entropy", entropy_label(policy.estimated_entropy_bits_x10()))
      set_status(
        "ok", "Generated by MoonBit with browser cryptographic randomness.",
      )
    }
    Err(message) => set_status("error", message)
  }
}

///|
fn generate_pin() -> Unit {
  let length = match parse_positive_int(element_value("pin-length")) {
    Some(value) => value
    None => {
      set_status("error", "PIN length must be a positive integer.")
      return
    }
  }
  match @lib.generate_pin(length, secure_random_u32) {
    Ok(value) => {
      set_text("output", value)
      set_text(
        "entropy",
        entropy_label(@lib.estimate_pin_entropy_bits_x10(length)),
      )
      set_status(
        "ok", "Generated by MoonBit with browser cryptographic randomness.",
      )
    }
    Err(_) => set_status("error", "PIN length must be between 4 and 32.")
  }
}

///|
fn generate_passphrase() -> Unit {
  let dictionary = [
    "amber", "atlas", "baker", "bamboo", "cedar", "cobalt", "coral", "delta", "ember",
    "falcon", "forest", "harbor", "indigo", "jasmine", "lantern", "lotus", "maple",
    "meadow", "meteor", "ocean", "orbit", "pebble", "quartz", "raven", "river", "saffron",
    "silver", "spruce", "summit", "tulip", "velvet", "willow",
  ]
  let policy = @lib.PassphrasePolicy::standard()
  match @lib.generate_passphrase(policy, dictionary, secure_random_u32) {
    Ok(value) => {
      set_text("output", value)
      set_text(
        "entropy",
        entropy_label(
          @lib.estimate_passphrase_entropy_bits_x10(policy, dictionary.length()),
        ),
      )
      set_status(
        "ok", "Generated by MoonBit with browser cryptographic randomness.",
      )
    }
    Err(message) => set_status("error", message)
  }
}

///|
fn main {
  bind_click("generate-password", generate_password)
  bind_click("generate-pin", generate_pin)
  bind_click("generate-passphrase", generate_passphrase)
  bind_click("copy", copy_output)
}
